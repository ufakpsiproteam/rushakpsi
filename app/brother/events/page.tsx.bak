'use client'

import BrotherNav from '@/components/brother/BrotherNav'
import Link from 'next/link'
import { useState } from 'react'

export default function BrotherEvents() {
  const [selectedEvent, setSelectedEvent] = useState<number | null>(null)
  const [selectedRushees, setSelectedRushees] = useState<number[]>([])
  const [step, setStep] = useState<'select' | 'evaluate'>('select')

  // TODO: Get from Supabase
  const events = [
    {
      id: 1,
      title: 'Meet the Chapter',
      type: 'Casual',
      date: 'January 15, 2024',
      time: '7:00 PM - 9:00 PM',
      acceptingEvals: true,
      attendees: [
        { id: 1, name: 'John Doe', photo: '👤' },
        { id: 2, name: 'Jane Smith', photo: '👤' },
        { id: 3, name: 'Michael Brown', photo: '👤' },
        { id: 4, name: 'Emily Davis', photo: '👤' },
        { id: 5, name: 'David Wilson', photo: '👤' },
      ]
    },
    {
      id: 2,
      title: 'Professional Panel',
      type: 'Professional',
      date: 'January 17, 2024',
      time: '6:30 PM - 8:30 PM',
      acceptingEvals: true,
      attendees: [
        { id: 6, name: 'Sarah Johnson', photo: '👤' },
        { id: 7, name: 'Chris Lee', photo: '👤' },
        { id: 8, name: 'Amanda Chen', photo: '👤' },
      ]
    },
    {
      id: 3,
      title: 'Game Night',
      type: 'Casual',
      date: 'January 19, 2024',
      time: '7:00 PM - 9:00 PM',
      acceptingEvals: false,
      attendees: []
    }
  ]

  const handleStartEvaluation = (eventId: number) => {
    setSelectedEvent(eventId)
    setStep('select')
  }

  const handleRusheeToggle = (rusheeId: number) => {
    setSelectedRushees(prev =>
      prev.includes(rusheeId)
        ? prev.filter(id => id !== rusheeId)
        : [...prev, rusheeId]
    )
  }

  const handleContinueToEvaluate = () => {
    if (selectedRushees.length > 0) {
      setStep('evaluate')
    }
  }

  const currentEvent = events.find(e => e.id === selectedEvent)

  return (
    <div className="min-h-screen bg-gradient-to-br from-akpsi-navy via-blue-900 to-akpsi-navy">
      <BrotherNav />

      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h1 className="text-3xl font-bold text-white mb-6">Rush Events</h1>

        {/* Events List */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {events.map((event) => (
            <div
              key={event.id}
              className="bg-white/10 backdrop-blur-sm border border-akpsi-gold/30 rounded-lg p-6"
            >
              <div className="flex justify-between items-start mb-3">
                <h2 className="text-2xl font-bold text-white">{event.title}</h2>
                <span
                  className={`px-3 py-1 rounded-full text-sm font-semibold ${
                    event.type === 'Professional'
                      ? 'bg-akpsi-gold text-akpsi-navy'
                      : 'bg-blue-500 text-white'
                  }`}
                >
                  {event.type}
                </span>
              </div>

              <div className="space-y-2 text-gray-300 mb-4">
                <p>📅 {event.date}</p>
                <p>🕐 {event.time}</p>
                <p>👥 {event.attendees.length} rushees attended</p>
              </div>

              {event.acceptingEvals ? (
                <button
                  onClick={() => handleStartEvaluation(event.id)}
                  className="w-full py-3 bg-akpsi-gold text-akpsi-navy rounded-lg font-semibold hover:bg-yellow-400 transition-colors"
                >
                  Start Evaluation
                </button>
              ) : (
                <div className="w-full py-3 bg-gray-600/50 text-gray-400 rounded-lg text-center">
                  {event.attendees.length === 0 ? 'Event Not Yet Completed' : 'Evaluations Locked'}
                </div>
              )}
            </div>
          ))}
        </div>

        {/* Evaluation Modal */}
        {selectedEvent && currentEvent && (
          <div className="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4 overflow-y-auto">
            <div className="bg-akpsi-navy border border-akpsi-gold rounded-lg p-6 max-w-4xl w-full my-8">
              {step === 'select' && (
                <>
                  <h2 className="text-2xl font-bold text-white mb-4">
                    {currentEvent.title} - Select Rushees
                  </h2>
                  <p className="text-gray-300 mb-6">
                    Select all rushees you spoke with or engaged during this event
                  </p>

                  <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                    {currentEvent.attendees.map((rushee) => (
                      <div
                        key={rushee.id}
                        onClick={() => handleRusheeToggle(rushee.id)}
                        className={`p-4 border-2 rounded-lg cursor-pointer transition-all ${
                          selectedRushees.includes(rushee.id)
                            ? 'border-akpsi-gold bg-akpsi-gold/20'
                            : 'border-white/20 bg-white/5 hover:border-white/40'
                        }`}
                      >
                        <div className="text-4xl mb-2 text-center">{rushee.photo}</div>
                        <p className="text-white text-sm text-center font-medium">{rushee.name}</p>
                      </div>
                    ))}
                  </div>

                  <div className="flex gap-3">
                    <button
                      onClick={() => {
                        setSelectedEvent(null)
                        setSelectedRushees([])
                        setStep('select')
                      }}
                      className="flex-1 py-3 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors"
                    >
                      Cancel
                    </button>
                    <button
                      onClick={handleContinueToEvaluate}
                      disabled={selectedRushees.length === 0}
                      className={`flex-1 py-3 rounded-lg font-semibold transition-colors ${
                        selectedRushees.length > 0
                          ? 'bg-akpsi-gold text-akpsi-navy hover:bg-yellow-400'
                          : 'bg-gray-600 text-gray-400 cursor-not-allowed'
                      }`}
                    >
                      Continue ({selectedRushees.length} selected)
                    </button>
                  </div>
                </>
              )}

              {step === 'evaluate' && (
                <>
                  <h2 className="text-2xl font-bold text-white mb-4">
                    Select Rushees to Evaluate
                  </h2>
                  <p className="text-gray-300 mb-6">
                    Choose at least 5 rushees to evaluate (you can evaluate all if you wish)
                  </p>

                  <div className="bg-white/10 rounded-lg p-4 mb-6 max-h-96 overflow-y-auto">
                    <div className="space-y-3">
                      {currentEvent.attendees
                        .filter(r => selectedRushees.includes(r.id))
                        .map((rushee) => (
                          <Link
                            key={rushee.id}
                            href={`/brother/evaluate/${rushee.id}?event=${selectedEvent}`}
                            className="flex items-center justify-between p-4 bg-akpsi-navy/50 border border-akpsi-gold/20 rounded-lg hover:border-akpsi-gold transition-colors"
                          >
                            <div className="flex items-center">
                              <div className="text-3xl mr-3">{rushee.photo}</div>
                              <span className="text-white font-medium">{rushee.name}</span>
                            </div>
                            <span className="text-akpsi-gold">→</span>
                          </Link>
                        ))}
                    </div>
                  </div>

                  <p className="text-sm text-gray-400 mb-4">
                    Minimum: 5 evaluations | You selected: {selectedRushees.length} rushees
                  </p>

                  <div className="flex gap-3">
                    <button
                      onClick={() => setStep('select')}
                      className="px-6 py-3 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors"
                    >
                      ← Back
                    </button>
                    <button
                      onClick={() => {
                        setSelectedEvent(null)
                        setSelectedRushees([])
                        setStep('select')
                      }}
                      className="flex-1 py-3 bg-akpsi-gold text-akpsi-navy rounded-lg font-semibold hover:bg-yellow-400 transition-colors"
                    >
                      Done
                    </button>
                  </div>
                </>
              )}
            </div>
          </div>
        )}
      </main>
    </div>
  )
}
