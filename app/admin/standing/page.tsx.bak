'use client'

import AdminNav from '@/components/admin/AdminNav'
import { useState } from 'react'

export default function AdminStanding() {
  const [showConfirmation, setShowConfirmation] = useState(false)
  const [changes, setChanges] = useState<any[]>([])

  // TODO: Get from Supabase
  const [rushees, setRushees] = useState([
    {
      id: 1,
      name: 'John Doe',
      casualEvents: 2,
      professionalEvents: 1,
      interactions: 15,
      evaluations: 8,
      standing: 'Event Minimums Met'
    },
    {
      id: 2,
      name: 'Jane Smith',
      casualEvents: 3,
      professionalEvents: 2,
      interactions: 20,
      evaluations: 12,
      standing: 'Event Minimums Met'
    },
    {
      id: 3,
      name: 'Michael Brown',
      casualEvents: 2,
      professionalEvents: 1,
      interactions: 12,
      evaluations: 6,
      standing: 'Event Minimums Met'
    },
    {
      id: 4,
      name: 'Emily Davis',
      casualEvents: 1,
      professionalEvents: 0,
      interactions: 5,
      evaluations: 2,
      standing: 'In Progress'
    },
    {
      id: 5,
      name: 'David Wilson',
      casualEvents: 2,
      professionalEvents: 1,
      interactions: 14,
      evaluations: 7,
      standing: 'Event Minimums Met'
    }
  ])

  const standingOptions = [
    'In Progress',
    'Event Minimums Met',
    'Invite Only (Y)',
    'Invite Only (N)',
    'Bid (Y)',
    'Bid (N)'
  ]

  const getStandingColor = (standing: string) => {
    switch (standing) {
      case 'In Progress':
        return 'bg-gray-500 text-white'
      case 'Event Minimums Met':
        return 'bg-blue-500 text-white'
      case 'Invite Only (Y)':
        return 'bg-green-500 text-white'
      case 'Invite Only (N)':
        return 'bg-red-500 text-white'
      case 'Bid (Y)':
        return 'bg-akpsi-gold text-akpsi-navy'
      case 'Bid (N)':
        return 'bg-red-700 text-white'
      default:
        return 'bg-gray-500 text-white'
    }
  }

  const handleStandingChange = (rusheeId: number, newStanding: string) => {
    setRushees(prev => prev.map(r =>
      r.id === rusheeId ? { ...r, standing: newStanding } : r
    ))
  }

  const handleSave = () => {
    // Collect all changes
    const inviteOnlyYes = rushees.filter(r => r.standing === 'Invite Only (Y)')
    const inviteOnlyNo = rushees.filter(r => r.standing === 'Invite Only (N)')
    const bidYes = rushees.filter(r => r.standing === 'Bid (Y)')
    const bidNo = rushees.filter(r => r.standing === 'Bid (N)')

    setChanges([
      { type: 'Invite Only (Y)', rushees: inviteOnlyYes },
      { type: 'Invite Only (N)', rushees: inviteOnlyNo },
      { type: 'Bid (Y)', rushees: bidYes },
      { type: 'Bid (N)', rushees: bidNo }
    ])
    setShowConfirmation(true)
  }

  const handleConfirmSave = () => {
    // TODO: Save to Supabase
    console.log('Saving changes:', rushees)
    alert('Changes saved successfully!')
    setShowConfirmation(false)
  }

  const handlePushUpdates = (type: string) => {
    // TODO: Push updates to rushees
    console.log('Pushing updates for:', type)
    alert(`${type} updates pushed to rushees!`)
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-akpsi-navy via-blue-900 to-akpsi-navy">
      <AdminNav />

      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="flex justify-between items-center mb-6">
          <div>
            <h1 className="text-3xl font-bold text-white mb-2">Rushee Standing</h1>
            <p className="text-gray-300">VP of Recruitment Only</p>
          </div>
          <button
            onClick={handleSave}
            className="px-6 py-3 bg-akpsi-gold text-akpsi-navy rounded-lg font-semibold hover:bg-yellow-400 transition-colors"
          >
            Save Changes
          </button>
        </div>

        {/* Info Box */}
        <div className="bg-blue-500/20 border border-blue-500 rounded-lg p-4 mb-6">
          <p className="text-blue-300 text-sm">
            ℹ️ "In Progress" and "Event Minimums Met" are automatic. Select "Invite Only" or "Bid" decisions manually. Changes will be confirmed before saving.
          </p>
        </div>

        {/* Rushees Table */}
        <div className="bg-white/10 backdrop-blur-sm border border-akpsi-gold/30 rounded-lg overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead className="bg-akpsi-navy/50">
                <tr>
                  <th className="px-4 py-3 text-left text-sm font-semibold text-akpsi-gold">Rushee Name</th>
                  <th className="px-4 py-3 text-center text-sm font-semibold text-akpsi-gold"># Casual</th>
                  <th className="px-4 py-3 text-center text-sm font-semibold text-akpsi-gold"># Professional</th>
                  <th className="px-4 py-3 text-center text-sm font-semibold text-akpsi-gold"># Interactions</th>
                  <th className="px-4 py-3 text-center text-sm font-semibold text-akpsi-gold"># Evals</th>
                  <th className="px-4 py-3 text-left text-sm font-semibold text-akpsi-gold">Standing</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-white/10">
                {rushees.map((rushee) => (
                  <tr key={rushee.id} className="hover:bg-white/5">
                    <td className="px-4 py-3 text-white font-medium">{rushee.name}</td>
                    <td className="px-4 py-3 text-center text-white">{rushee.casualEvents}</td>
                    <td className="px-4 py-3 text-center text-white">{rushee.professionalEvents}</td>
                    <td className="px-4 py-3 text-center text-white">{rushee.interactions}</td>
                    <td className="px-4 py-3 text-center text-white">{rushee.evaluations}</td>
                    <td className="px-4 py-3">
                      <select
                        value={rushee.standing}
                        onChange={(e) => handleStandingChange(rushee.id, e.target.value)}
                        disabled={rushee.casualEvents < 2 || rushee.professionalEvents < 1}
                        className={`px-3 py-2 rounded-lg font-semibold text-sm ${
                          getStandingColor(rushee.standing)
                        } ${
                          rushee.casualEvents < 2 || rushee.professionalEvents < 1
                            ? 'opacity-50 cursor-not-allowed'
                            : 'cursor-pointer'
                        }`}
                      >
                        {standingOptions.map((option) => (
                          <option key={option} value={option}>
                            {option}
                          </option>
                        ))}
                      </select>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Push Updates Section */}
        <div className="mt-8 bg-white/10 backdrop-blur-sm border border-akpsi-gold/30 rounded-lg p-6">
          <h2 className="text-xl font-bold text-white mb-4">Push Status Updates</h2>
          <p className="text-gray-300 mb-4">
            Send status updates to rushees. Only rushees with the selected status will receive notifications.
          </p>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <button
              onClick={() => handlePushUpdates('Invite Only (Y)')}
              className="p-4 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition-colors"
            >
              Push Invite Only (Y)
            </button>
            <button
              onClick={() => handlePushUpdates('Invite Only (N)')}
              className="p-4 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold transition-colors"
            >
              Push Invite Only (N)
            </button>
            <button
              onClick={() => handlePushUpdates('Bid (Y)')}
              className="p-4 bg-akpsi-gold hover:bg-yellow-400 text-akpsi-navy rounded-lg font-semibold transition-colors"
            >
              Push Bid (Y)
            </button>
            <button
              onClick={() => handlePushUpdates('Bid (N)')}
              className="p-4 bg-red-700 hover:bg-red-800 text-white rounded-lg font-semibold transition-colors"
            >
              Push Bid (N)
            </button>
          </div>
        </div>

        {/* Confirmation Modal */}
        {showConfirmation && (
          <div className="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4">
            <div className="bg-akpsi-navy border border-akpsi-gold rounded-lg p-6 max-w-2xl w-full max-h-[80vh] overflow-y-auto">
              <h2 className="text-2xl font-bold text-white mb-4">Confirm Changes</h2>
              <p className="text-gray-300 mb-6">
                Please review the following status changes before confirming:
              </p>

              <div className="space-y-4 mb-6">
                {changes.filter(c => c.rushees.length > 0).map((change) => (
                  <div key={change.type} className="bg-white/10 rounded-lg p-4">
                    <h3 className={`font-semibold mb-2 px-3 py-1 rounded inline-block ${getStandingColor(change.type)}`}>
                      {change.type} ({change.rushees.length})
                    </h3>
                    <ul className="mt-2 space-y-1">
                      {change.rushees.map((rushee: any) => (
                        <li key={rushee.id} className="text-white text-sm ml-4">
                          • {rushee.name}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div className="bg-yellow-500/20 border border-yellow-500 rounded-lg p-4 mb-6">
                <p className="text-yellow-400 text-sm font-semibold">
                  ⚠️ Warning: These changes will update rushee statuses and may trigger notifications. Please ensure all decisions are final.
                </p>
              </div>

              <div className="flex gap-3">
                <button
                  onClick={() => setShowConfirmation(false)}
                  className="flex-1 py-3 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors"
                >
                  Cancel
                </button>
                <button
                  onClick={handleConfirmSave}
                  className="flex-1 py-3 bg-akpsi-gold text-akpsi-navy rounded-lg font-semibold hover:bg-yellow-400 transition-colors"
                >
                  Confirm & Save
                </button>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  )
}
